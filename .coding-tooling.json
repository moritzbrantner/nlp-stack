{
  "schemaVersion": 1,
  "tiers": {
    "fast": [
      "format:check",
      "test:integration"
    ],
    "full": [
      "repository:verify"
    ]
  },
  "repositoryCommands": {
    "format:check": [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "test:integration": [
      "bash",
      "-lc",
      "python3 scripts/check_repository_boundaries.py --check && python3 scripts/check_release_plan.py --check docs/repository-split/release-plan.json && python3 -m unittest discover -s scripts -p 'test_*.py'"
    ],
    "repository:verify": [
      "bash",
      "scripts/check.sh"
    ]
  },
  "conventionRefs": [
    "AGENT-001",
    "AGENT-002",
    "AGENT-003",
    "AGENT-007",
    "AGENT-008",
    "AGENT-009",
    "TEST-002",
    "TEST-005",
    "TEST-006",
    "TEST-007",
    "RUST-001",
    "RUST-002",
    "RUST-003"
  ]
}
