{
  "name": "@moritzbrantner/nlp-stack-pages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "shared-ui:build": "bun run --cwd ../packages/nlp-app-ui build",
    "dev": "bun run shared-ui:build && next dev",
    "build": "bun run shared-ui:build && next build",
    "typecheck": "bun run shared-ui:build && next typegen && tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@storybook/nextjs-vite": "10.6.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "jsdom": "27.4.0",
    "playwright": "1.64.1",
    "postcss": "8.5.31",
    "storybook": "10.6.2",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  }
}
